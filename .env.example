# 全栈环境变量模板（Docker Compose 使用）
# 复制为 .env 后按需修改

# 数据库
POSTGRES_USER=fastapi
POSTGRES_PASSWORD=fastapi
POSTGRES_DB=fastapi

# 中间件宿主映射端口（容器内固定 5432/6379；与宿主机冲突时才改）
POSTGRES_PORT=5433
REDIS_PORT=6380

# 混合模式连接串（本地跑后端时用；全 Docker 时被 compose 注入的容器内连接串覆盖，不生效）
DATABASE_URL=postgresql+asyncpg://fastapi:fastapi@localhost:5433/fastapi
REDIS_URL=redis://localhost:6380/0

# 安全
SECRET_KEY=change-me-in-production-0123456789

# CORS（可选显式覆盖；不设时由 FRONTEND_PORT 自动派生 http://localhost:<port>）
# ALLOWED_ORIGINS=http://localhost:5173

# 初始超管
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123

# 前端端口（唯一事实源：vite dev 端口 / 后端 CORS 派生 / Docker 宿主映射 均跟随此处）
FRONTEND_PORT=5173

# 后端 API 端口（唯一事实源：vite dev 代理默认 / Docker 宿主映射 跟随此处）
BACKEND_PORT=8000

# 监控（可选）
SENTRY_DSN=
