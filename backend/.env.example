# 应用
APP_NAME=FastAPI Base
APP_ENV=dev            # dev | test | prod
DEBUG=true
SECRET_KEY=change-me-to-a-random-32+bytes-string
# ALLOWED_ORIGINS=http://localhost:5173  # 可选显式覆盖；不设时由根 .env 的 FRONTEND_PORT 派生

# 数据库连接串 DATABASE_URL / REDIS_URL：由根目录 .env 统一配置（混合模式用），勿在此重复设置

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# 限流（次/分钟）
RATE_LIMIT_PER_MINUTE=60

# 初始超管
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123

# 监控
SENTRY_DSN=
